{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start backend",
            "type": "shell",
            "command": "node server.js",
            "options": {
                "cwd": "${workspaceFolder}/webSIGAE/BackEnd"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": { "regexp": "." },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "listening|running|started|port"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "label": "BackEnd"
            }
        },
        {
            "label": "start frontend",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/webSIGAE/FrontEnd"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": { "regexp": "." },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Local:"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "label": "FrontEnd"
            }
        }
    ]
}