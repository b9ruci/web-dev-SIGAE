{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build backend",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "/webSIGAE/BackEnd/BackEnd.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "watch backend",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "/webSIGAE/BackEnd/BackEnd.csproj"
            ],
            "problemMatcher": "$msCompile",
            "isBackground": true
        },
        {
            "label": "dev frontend",
            "type": "npm",
            "script": "dev",
            "path": "/webSIGAE/FrontEnd",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
    {
        "label": "build frontend",
        "type": "shell",
        "command": "npm run build",
        "options": {
        "cwd": "${workspaceFolder}/webSIGAE/FrontEnd"
    },
    "problemMatcher": [],
    "group": "build"
    }
    ]
}